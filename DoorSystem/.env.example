# ==========================================
# SMART AI DOOR SECURITY SYSTEM - ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to '.env' inside the /backend directory.
# NEVER commit the actual '.env' file containing real secrets to GitHub!

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Device Authentication Key (Shared secret between ESP32 and Backend)
DEVICE_AUTH_TOKEN=smart-door-esp32-secret-token-2026

# Database Configuration
DATABASE_URL=./data/doorsystem.db

# AI Integration (Google Gemini API)
# Get your free API key at: https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here

# Door Controller Settings (Default Timers in Milliseconds)
DOOR_UNLOCK_DURATION_MS=5000
MOTION_COOLDOWN_MS=15000
REQUEST_TIMEOUT_MS=60000
